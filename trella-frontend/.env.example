NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional realtime (WebSocket) layer — design §7, Req 13.9 / 19.10.
# Set to the backend WebSocket origin to enable live task + notification
# updates (e.g. ws://localhost:8000). Leave unset/blank to disable: the app
# then relies on TanStack Query refetch-on-focus + optimistic updates as the
# fallback and opens no socket.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:8000
